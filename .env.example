# Supabase Realtime (required for cloud Live Classroom board sync)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# LiveKit Cloud (optional, required for Live Voice in Expo Dev Builds)
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
EXPO_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/livekit-token

# Monetization Environment ('development' | 'production')
EXPO_PUBLIC_IAP_ENV=development

# RevenueCat Public SDK Keys (Dev / Sandbox vs Production)
EXPO_PUBLIC_REVENUECAT_IOS_KEY_DEV=appl_dev_placeholder
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY_DEV=goog_dev_placeholder
EXPO_PUBLIC_REVENUECAT_IOS_KEY_PROD=appl_prod_placeholder
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY_PROD=goog_prod_placeholder

# Google AdMob Unit IDs (optional; leave blank to use Google test IDs in dev)
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=

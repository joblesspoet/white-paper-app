# Supabase Realtime (required for cloud Live Classroom board sync)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# LiveKit Cloud (optional, required for Live Voice in Expo Dev Builds)
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
EXPO_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/livekit-token
